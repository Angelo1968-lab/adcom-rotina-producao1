generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Cliente {
  id        String   @id @default(cuid())
  nome      String
  segmento  String
  criadoEm  DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("clientes")
}
